rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function isTeacher() { return role() == 'teacher'; }
    function isStudent() { return role() == 'student'; }
    function ownsStudentRecord() {
      return isStudent() && resource.data.studentUserId == request.auth.uid;
    }

    // Assignment documents use the deterministic ID:
    // <teacher auth UID>__<subject document ID>__<class document ID>.
    // Legacy/random-ID assignments do not grant access; recreate them through
    // the admin assignment screen after linking the teacher's Auth UID.
    function hasTeachingAssignment(classId, subjectId) {
      return isTeacher()
        && classId is string
        && subjectId is string
        && exists(/databases/$(database)/documents/teacherAssignments/$(request.auth.uid + '__' + subjectId + '__' + classId));
    }
    // Enrollment documents use <student ID>__<class ID>__<academic year ID>.
    // This deterministic path lets Rules verify class membership without a query.
    function hasMatchingEnrollment(studentId, classId, academicYearId, studentUserId) {
      return studentId is string
        && classId is string
        && academicYearId is string
        && exists(/databases/$(database)/documents/enrollments/$(studentId + '__' + classId + '__' + academicYearId))
        && get(/databases/$(database)/documents/enrollments/$(studentId + '__' + classId + '__' + academicYearId)).data.studentId == studentId
        && get(/databases/$(database)/documents/enrollments/$(studentId + '__' + classId + '__' + academicYearId)).data.classId == classId
        && get(/databases/$(database)/documents/enrollments/$(studentId + '__' + classId + '__' + academicYearId)).data.academicYearId == academicYearId
        && get(/databases/$(database)/documents/enrollments/$(studentId + '__' + classId + '__' + academicYearId)).data.studentUserId == studentUserId
        && get(/databases/$(database)/documents/enrollments/$(studentId + '__' + classId + '__' + academicYearId)).data.status != 'Withdrawn';
    }
    function recordHasMatchingEnrollment(data) {
      return hasMatchingEnrollment(data.studentId, data.classId, data.academicYearId, data.studentUserId);
    }
    function canReadAcademicRecord() {
      return isAdmin()
        || ownsStudentRecord()
        || (hasTeachingAssignment(resource.data.classId, resource.data.subjectId)
          && recordHasMatchingEnrollment(resource.data));
    }
    function canCreateAcademicRecord() {
      return isAdmin()
        || (hasTeachingAssignment(request.resource.data.classId, request.resource.data.subjectId)
          && recordHasMatchingEnrollment(request.resource.data));
    }
    function canUpdateAcademicRecord() {
      return isAdmin()
        || (hasTeachingAssignment(resource.data.classId, resource.data.subjectId)
          && recordHasMatchingEnrollment(resource.data)
          && recordHasMatchingEnrollment(request.resource.data)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.academicYearId == resource.data.academicYearId);
    }
    function canDeleteAcademicRecord() {
      return isAdmin()
        || (hasTeachingAssignment(resource.data.classId, resource.data.subjectId)
          && recordHasMatchingEnrollment(resource.data));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // User accounts and profiles are provisioned by the trusted admin-only
      // Cloud Function. Never allow public self-registration or self-assigned roles.
      allow create: if isAdmin();
      // Admins may edit non-role profile fields, and may reassign only
      // teacher/student profiles between those two roles. Admin privileges
      // are granted only by the trusted first-admin provisioning function.
      allow update: if (isAdmin()
          && request.resource.data.role == resource.data.role)
        || (isAdmin()
          && resource.data.role in ['teacher', 'student']
          && request.resource.data.role in ['teacher', 'student'])
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /roleInvitations/{invitationId} {
      // Invitations can only be issued by an existing administrator.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['email', 'role', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.role in ['teacher', 'student']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow get: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn()
          && resource.data.email == request.auth.token.email
          && resource.data.status == 'pending');
    }

    match /institutions/{id} { allow read, write: if isAdmin(); }
    match /branches/{id} { allow read, write: if isAdmin(); }
    match /programs/{id} { allow read, write: if isAdmin(); }
    match /academicYears/{id} { allow read, write: if isAdmin(); }

    match /classes/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }
    match /sections/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    // Student profiles contain personal information. Teachers should work from
    // assigned academic records rather than browse every student's profile.
    match /students/{id} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /enrollments/{id} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /teacherAssignments/{id} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /teacherClassAccess/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /assessments/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /marks/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /predictions/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /recommendations/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }
  }
}
