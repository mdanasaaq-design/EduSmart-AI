rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function isTeacher() { return role() == 'teacher'; }
    function isStudent() { return role() == 'student'; }
    function ownsStudentRecord() {
      return isStudent() && resource.data.studentUserId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Roles are assigned only by an existing administrator. A newly
      // authenticated user must not be able to grant themselves any role.
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /institutions/{id} { allow read, write: if isAdmin(); }
    match /branches/{id} { allow read, write: if isAdmin(); }
    match /programs/{id} { allow read, write: if isAdmin(); }
    match /academicYears/{id} { allow read, write: if isAdmin(); }

    // Teachers can access the academic structure, but only admins maintain it.
    match /classes/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }
    match /sections/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAdmin() || isTeacher()
        || (isStudent() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || isTeacher();
    }

    match /teachers/{id} {
      allow read: if isAdmin() || (isTeacher() && id == request.auth.uid);
      allow write: if isAdmin() || (isTeacher() && id == request.auth.uid);
    }

    match /subjects/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /enrollments/{id} {
      allow read: if isAdmin() || isTeacher()
        || (isStudent() && resource.data.studentUserId == request.auth.uid);
      allow write: if isAdmin() || isTeacher();
    }

    match /teacherAssignments/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || isTeacher() || ownsStudentRecord();
      allow write: if isAdmin() || isTeacher();
    }

    match /assessments/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin() || isTeacher();
    }

    match /marks/{id} {
      allow read: if isAdmin() || isTeacher() || ownsStudentRecord();
      allow write: if isAdmin() || isTeacher();
    }

    match /predictions/{id} {
      allow read: if isAdmin() || isTeacher() || ownsStudentRecord();
      allow write: if isAdmin() || isTeacher();
    }

    match /recommendations/{id} {
      allow read: if isAdmin() || isTeacher() || ownsStudentRecord();
      allow write: if isAdmin() || isTeacher();
    }
  }
}
