rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function isTeacher() { return role() == 'teacher'; }
    function isStudent() { return role() == 'student'; }
    function ownsStudentRecord() {
      return isStudent() && resource.data.studentUserId == request.auth.uid;
    }

    // Assignment documents use the deterministic ID:
    // <teacher auth UID>__<subject document ID>__<class document ID>.
    // Legacy/random-ID assignments do not grant access; recreate them through
    // the admin assignment screen after linking the teacher's Auth UID.
    function hasTeachingAssignment(classId, subjectId) {
      return isTeacher()
        && classId is string
        && subjectId is string
        && exists(/databases/$(database)/documents/teacherAssignments/$(request.auth.uid + '__' + subjectId + '__' + classId));
    }
    function canReadAcademicRecord() {
      return isAdmin()
        || ownsStudentRecord()
        || hasTeachingAssignment(resource.data.classId, resource.data.subjectId);
    }
    function canCreateAcademicRecord() {
      return isAdmin()
        || hasTeachingAssignment(request.resource.data.classId, request.resource.data.subjectId);
    }
    function canUpdateAcademicRecord() {
      return isAdmin()
        || (hasTeachingAssignment(resource.data.classId, resource.data.subjectId)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.subjectId == resource.data.subjectId);
    }
    function canDeleteAcademicRecord() {
      return isAdmin() || hasTeachingAssignment(resource.data.classId, resource.data.subjectId);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Roles are assigned only by an existing administrator.
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /institutions/{id} { allow read, write: if isAdmin(); }
    match /branches/{id} { allow read, write: if isAdmin(); }
    match /programs/{id} { allow read, write: if isAdmin(); }
    match /academicYears/{id} { allow read, write: if isAdmin(); }

    match /classes/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }
    match /sections/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    // Student profiles contain personal information. Teachers should work from
    // assigned academic records rather than browse every student's profile.
    match /students/{id} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /enrollments/{id} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /teacherAssignments/{id} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /teacherClassAccess/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /assessments/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /marks/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /predictions/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }

    match /recommendations/{id} {
      allow read: if canReadAcademicRecord();
      allow create: if canCreateAcademicRecord();
      allow update: if canUpdateAcademicRecord();
      allow delete: if canDeleteAcademicRecord();
    }
  }
}
