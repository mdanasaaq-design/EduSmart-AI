rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isTeacher() { return role() == 'teacher'; }
    function isStudent() { return role() == 'student'; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /institutions/{id} { allow read, write: if isAdmin(); }
    match /branches/{id} { allow read, write: if isAdmin(); }
    match /programs/{id} { allow read, write: if isAdmin(); }
    match /academicYears/{id} { allow read, write: if isAdmin(); }

    match /classes/{id} { allow read, write: if isAdmin() || isTeacher(); }
    match /sections/{id} { allow read, write: if isAdmin() || isTeacher(); }

    match /students/{id} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || isTeacher();
    }

    match /teachers/{id} {
      allow read, write: if isAdmin() || (isTeacher() && id == request.auth.uid);
    }

    match /subjects/{id} { allow read, write: if isAdmin() || isTeacher(); }

    match /enrollments/{id} {
      allow read, write: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentUserId == request.auth.uid);
    }

    match /teacherAssignments/{id} { allow read, write: if isAdmin() || isTeacher(); }
    match /attendance/{id} { allow read, write: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentUserId == request.auth.uid); }
    match /assessments/{id} { allow read, write: if isAdmin() || isTeacher(); }
    match /marks/{id} { allow read, write: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentUserId == request.auth.uid); }
    match /predictions/{id} { allow read, write: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentUserId == request.auth.uid); }
    match /recommendations/{id} { allow read, write: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentUserId == request.auth.uid); }
  }
}
